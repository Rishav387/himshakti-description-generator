{
  "info": {
    "name": "HimShakti Auth API — W6_AuthAPICollection_TBI-26100016",
    "description": "Auth API collection for Week 6. Covers Register, Login (saves JWT), protected routes using saved JWT, and rate limit test.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:5000" },
    { "key": "jwt_token", "value": "" }
  ],
  "item": [
    {
      "name": "1 — Register User",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/auth/register",
        "description": "Register a new user. Returns JWT token on success.",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Rishav Kumar\",\n  \"email\": \"rishav@himshakti.in\",\n  \"password\": \"password123\"\n}"
        }
      },
      "response": [
        {
          "name": "201 Created — Registration success",
          "status": "Created",
          "code": 201,
          "body": "{\n  \"success\": true,\n  \"message\": \"Account created successfully\",\n  \"token\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n  \"user\": {\n    \"id\": \"6a3de02075c39009b86531dc\",\n    \"name\": \"Rishav Kumar\",\n    \"email\": \"rishav@himshakti.in\",\n    \"role\": \"user\",\n    \"avatar\": null\n  }\n}"
        },
        {
          "name": "400 Bad Request — Validation error",
          "status": "Bad Request",
          "code": 400,
          "body": "{\n  \"success\": false,\n  \"error\": \"Password must be at least 6 characters\"\n}"
        },
        {
          "name": "409 Conflict — Email already exists",
          "status": "Conflict",
          "code": 409,
          "body": "{\n  \"success\": false,\n  \"error\": \"An account with this email already exists.\"\n}"
        }
      ],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {",
              "  const data = pm.response.json();",
              "  pm.collectionVariables.set('jwt_token', data.token);",
              "  console.log('Token saved:', data.token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "2 — Login User (saves JWT)",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/auth/login",
        "description": "Login with email and password. Automatically saves JWT token to collection variable.",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"rishav@himshakti.in\",\n  \"password\": \"password123\"\n}"
        }
      },
      "response": [
        {
          "name": "200 OK — Login success with JWT",
          "status": "OK",
          "code": 200,
          "body": "{\n  \"success\": true,\n  \"message\": \"Logged in successfully\",\n  \"token\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n  \"user\": {\n    \"id\": \"6a3de02075c39009b86531dc\",\n    \"name\": \"Rishav Kumar\",\n    \"email\": \"rishav@himshakti.in\",\n    \"role\": \"user\",\n    \"avatar\": null\n  }\n}"
        },
        {
          "name": "401 Unauthorized — Wrong password",
          "status": "Unauthorized",
          "code": 401,
          "body": "{\n  \"success\": false,\n  \"error\": \"Invalid email or password.\"\n}"
        }
      ],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json();",
              "  pm.collectionVariables.set('jwt_token', data.token);",
              "  console.log('JWT saved to variable jwt_token');",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "3 — Get My Profile (Protected)",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/auth/me",
        "description": "Protected route — returns logged-in user profile. Requires JWT.",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
        ]
      },
      "response": [
        {
          "name": "200 OK — Profile returned",
          "status": "OK",
          "code": 200,
          "body": "{\n  \"success\": true,\n  \"user\": {\n    \"id\": \"6a3de02075c39009b86531dc\",\n    \"name\": \"Rishav Kumar\",\n    \"email\": \"rishav@himshakti.in\",\n    \"role\": \"user\",\n    \"avatar\": null,\n    \"authProvider\": \"local\"\n  }\n}"
        },
        {
          "name": "401 Unauthorized — No token",
          "status": "Unauthorized",
          "code": 401,
          "body": "{\n  \"success\": false,\n  \"error\": \"Not authorized. No token provided.\"\n}"
        }
      ]
    },
    {
      "name": "4 — Get All Products (Protected with JWT)",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/products",
        "description": "Product endpoint using saved JWT token.",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
        ]
      },
      "response": [
        {
          "name": "200 OK — Products returned",
          "status": "OK",
          "code": 200,
          "body": "{\n  \"success\": true,\n  \"count\": 6,\n  \"data\": []\n}"
        }
      ]
    },
    {
      "name": "5 — Access Protected Route Without Token (401 Test)",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/auth/me",
        "description": "No token sent — should return 401.",
        "header": []
      },
      "response": [
        {
          "name": "401 Unauthorized — No token",
          "status": "Unauthorized",
          "code": 401,
          "body": "{\n  \"success\": false,\n  \"error\": \"Not authorized. No token provided.\"\n}"
        }
      ]
    },
    {
      "name": "6 — Logout (Protected)",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/auth/logout",
        "description": "Logout — requires valid JWT.",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
        ]
      },
      "response": [
        {
          "name": "200 OK — Logged out",
          "status": "OK",
          "code": 200,
          "body": "{\n  \"success\": true,\n  \"message\": \"Logged out successfully. Please delete the token on the client.\"\n}"
        }
      ]
    },
    {
      "name": "7 — Rate Limit Test (send 11+ times for 429)",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/auth/login",
        "description": "Send this request 11+ times rapidly to trigger 429 rate limit response.",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test@test.com\",\n  \"password\": \"wrongpassword\"\n}"
        }
      },
      "response": [
        {
          "name": "429 Too Many Requests",
          "status": "Too Many Requests",
          "code": 429,
          "body": "{\n  \"success\": false,\n  \"error\": \"Too many attempts. Please try again after 15 minutes.\"\n}"
        }
      ]
    }
  ]
}
