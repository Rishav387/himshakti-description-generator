# Copy this file to .env and fill in your values
# Never commit .env to GitHub

PORT=5000
MONGODB_URI=mongodb+srv://himshakti:<password>@cluster0.xxxxx.mongodb.net/himshakti?retryWrites=true&w=majority
NODE_ENV=production

# JWT
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long
JWT_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Groq AI API
GROQ_API_KEY=your_groq_api_key_here

# URLs — update CLIENT_URL to your Vercel URL after deployment
SERVER_URL=https://your-app-api.onrender.com
CLIENT_URL=https://your-app.vercel.app
